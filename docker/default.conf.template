map "${GLITCHTIP_DSN}" $glitchtip_origin {
    "~^(?<glitchtip_scheme>https?)://[^@/]+@(?<glitchtip_host>[^/]+)/" "$glitchtip_scheme://$glitchtip_host";
    default "";
}

map "${MATOMO_URL}|${MATOMO_SITE_ID}" $matomo_origin {
    "~^(?<matomo_base>https?://[^/|]+)[^|]*\|.+$" $matomo_base;
    default "";
}

map "${API_URL}" $api_origin {
    "~^(?<api_base>https?://[^/]+)" $api_base;
    default "";
}

# Demande de renseignement (/contact?produit=<slug>) : seul un slug valide désigne une page pré-rendue
map $arg_produit $contact_product {
    "~^[a-z0-9-]+$" $arg_produit;
    default "";
}

map "${MAINTENANCE}" $maintenance {
    default 0;
    1 1;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;
    server_tokens off;

    charset utf-8;
    charset_types text/css text/javascript application/javascript application/manifest+json image/svg+xml text/xml text/plain;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml text/plain;

    ssi on;
    set $glitchtip_dsn "${GLITCHTIP_DSN}";
    set $glitchtip_environment "${GLITCHTIP_ENVIRONMENT}";
    set $matomo_url "${MATOMO_URL}";
    set $matomo_site_id "${MATOMO_SITE_ID}";
    set $api_url "${API_URL}";
    set $api_scenario "${API_SCENARIO}";
    include /etc/nginx/snippets/identity-style.conf;

    include /etc/nginx/snippets/security-headers.conf;

    error_page 404 /404.html;
    error_page 500 502 504 /50x.html;
    error_page 405 /405.html;
    error_page 503 /503.html;

    location / {
        if ($maintenance) {
            return 503;
        }
        try_files $uri $uri/index.html =404;
    }

    # Pages d'une langue autre que celle par défaut sous /<langue>/ (section 29 bis de la spec commune) :
    # les règles ci-dessous acceptent ce préfixe ($lang), et une langue non générée n'a aucun fichier (404)

    # Fiche article : page pré-rendue à la construction de l'image si elle existe, sinon le gabarit, rempli par JavaScript
    location ~ "^(?<lang>/[a-z]{2})?/blog/(?<slug>[a-z0-9-]+)/?$" {
        if ($maintenance) {
            return 503;
        }
        try_files $lang/blog/$slug/index.html $lang/blog/fiche.html =404;
    }

    # Fiche produit : même règle que la fiche article
    location ~ "^(?<lang>/[a-z]{2})?/produit/(?<slug>[a-z0-9-]+)/?$" {
        if ($maintenance) {
            return 503;
        }
        try_files $lang/produit/$slug/index.html $lang/produit/fiche.html =404;
    }

    # Contact avec un produit : page pré-rendue à la construction si l'API connaissait le produit, sinon le
    # formulaire de contact simple
    location ~ "^(?<lang>/[a-z]{2})?/contact/?$" {
        if ($maintenance) {
            return 503;
        }
        try_files $lang/contact/demande/$contact_product.html $lang/contact/index.html =404;
    }

    location ~ "^(/[a-z]{2})?/contact/demande/" {
        internal;
    }

    location ~* \.(css|js|map|svg|png|ico|jpg|webp|avif|webmanifest)$ {
        try_files $uri =404;
        expires 1h;
    }

    location ~ "^(/[a-z]{2})?/partials/" {
        internal;
    }

    location = /404.html {
        internal;
    }

    location = /50x.html {
        internal;
    }

    location = /405.html {
        internal;
    }

    location = /503.html {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Retry-After "3600" always;
    }
}
